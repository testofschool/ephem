{
 "ociVersion": "1.0.0",
 "process": {
  "user": {
   "uid": 0,
   "gid": 0
  },
  "args": [
   "/usr/bin/pdftotext",
   "/in/doc00.pdf",
   "-"
  ],
  "env": [
   "PATH=/usr/bin:/bin",
   "HOME=/tmp",
   "LANG=C.UTF-8"
  ],
  "cwd": "/tmp",
  "capabilities": {
   "bounding": [
    "CAP_AUDIT_WRITE",
    "CAP_KILL",
    "CAP_NET_BIND_SERVICE"
   ],
   "effective": [
    "CAP_AUDIT_WRITE",
    "CAP_KILL",
    "CAP_NET_BIND_SERVICE"
   ],
   "inheritable": [
    "CAP_AUDIT_WRITE",
    "CAP_KILL",
    "CAP_NET_BIND_SERVICE"
   ],
   "permitted": [
    "CAP_AUDIT_WRITE",
    "CAP_KILL",
    "CAP_NET_BIND_SERVICE"
   ]
  },
  "rlimits": [
   {
    "type": "RLIMIT_NOFILE",
    "hard": 1024,
    "soft": 1024
   }
  ],
  "terminal": false
 },
 "root": {
  "path": "/opt/ephem-bench/kit/gvroot",
  "readonly": false
 },
 "hostname": "runsc",
 "mounts": [
  {
   "destination": "/proc",
   "type": "proc",
   "source": "proc"
  },
  {
   "destination": "/dev",
   "type": "tmpfs",
   "source": "tmpfs"
  },
  {
   "destination": "/tmp",
   "type": "tmpfs",
   "source": "tmpfs",
   "options": [
    "nosuid",
    "nodev",
    "mode=1777"
   ]
  },
  {
   "destination": "/usr",
   "type": "bind",
   "source": "/usr",
   "options": [
    "rbind",
    "ro"
   ]
  },
  {
   "destination": "/etc",
   "type": "bind",
   "source": "/etc",
   "options": [
    "rbind",
    "ro"
   ]
  },
  {
   "destination": "/var/cache/fontconfig",
   "type": "bind",
   "source": "/var/cache/fontconfig",
   "options": [
    "rbind",
    "ro"
   ]
  }
 ],
 "linux": {
  "namespaces": [
   {
    "type": "pid"
   },
   {
    "type": "ipc"
   },
   {
    "type": "uts"
   },
   {
    "type": "mount"
   },
   {
    "type": "network"
   }
  ]
 }
}